# Copie este arquivo para .env e ajuste.

# Banco de dados. Hoje SQLite local; para hospedar, troque por Postgres:
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/treino
DATABASE_URL=sqlite:///./data/treino.db

# Fuso usado para agrupar treinos por dia e semana
TIMEZONE=America/Sao_Paulo

# Frequência cardíaca máxima e de repouso, em bpm.
# Deixe em branco para o sistema usar uma ESTIMATIVA a partir dos seus treinos
# (o comando `treino fc` mostra a estimativa). O ideal é preencher com valores medidos.
FC_MAX=
FC_REPOUSO=

# Token exigido pela API (troque por um valor longo e aleatório)
API_TOKEN=troque-este-token

# Notificação do Windows quando chega treino novo
NOTIFICACOES=true

# Chat com IA: provedor padrão (claude ou gemini)
IA_PROVEDOR=claude
# Claude: usa o Claude Code embutido no claude-agent-sdk. Sem ANTHROPIC_API_KEY no ambiente,
# ele usa o login que já existe no Claude Code deste PC (veja o README).
CLAUDE_MODELO=claude-opus-5-5
# Esforço de raciocínio do Claude: low, medium, high, xhigh, max (vazio = padrão do modelo)
CLAUDE_ESFORCO=
# Gemini: chave gratuita do Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.8-flash
# Modelo de reserva quando o principal estiver sobrecarregado (erro 503/504 do Google)
GEMINI_MODELO_RESERVA=gemini-3.6-flash

# Painel no celular (guia em docs/celular.md): endereço que o `tailscale serve` mostra.
# Usado no QR code da página "Conectar celular". Vazio = celular não configurado.
PAINEL_URL_CELULAR=
